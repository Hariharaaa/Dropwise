# Copy to .env (git-ignored). Never commit real keys.

# Tavily (optional): https://app.tavily.com. Needed only for live registry refresh and live claim sources.
TAVILY_API_KEY=

# All model calls go through Bifrost's OpenAI-compatible endpoint.
BIFROST_URL=http://localhost:8080
# Bifrost model name in provider/model form.
EXTRACTION_MODEL=anthropic/claude-haiku-5-5
# Optional Bifrost virtual key (sent as x-bf-vk), so Dropwise's own AI traffic is budgeted like any team's.
BIFROST_VIRTUAL_KEY=

# Right-sizing quality eval (npm run eval -- quality): the two tiers B routes between.
SMALL_MODEL=anthropic/claude-haiku-5-5
LARGE_MODEL=anthropic/claude-opus-5-5

# Intelligence API
PORT=8787
# Restrict CORS to the dashboard's origin, e.g. http://localhost:3000 (defaults to *).
DASHBOARD_ORIGIN=
